{
  "name": "panel-profits",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "guardrail:verify": "npx tsx scripts/verify_zero_fake_data.ts",
    "build": "npx tsx scripts/verify_zero_fake_data.ts && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "worker:sync-equities": "node --experimental-strip-types --env-file=.env.local scripts/workers/sync_verified_equities_to_supabase.ts",
    "worker:sync-equities:daemon": "node --experimental-strip-types --env-file=.env.local scripts/workers/sync_verified_equities_to_supabase.ts --daemon --interval 300",
    "migrate:overwrite-rounded-prices": "node --experimental-strip-types --env-file=.env.local scripts/workers/overwrite_rounded_prices_in_supabase.ts",
    "fetch:pricecharting": "python3 ../scripts/download_pricecharting_daily.py --wait",
    "sniper:auctions": "node --import tsx scripts/sniper-public-auctions.ts"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/pg": "^8.23.1",
    "@vercel/oidc": "3.2.0",
    "ai": "^7.0.140",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.475.0",
    "next": "^16.3.5",
    "node-html-parser": "9.0.4",
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0",
    "playwright": "1.64.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.0.2",
    "tsx": "4.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/parser": "^8.70.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.1",
    "eslint-config-next": "^16.3.5",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "ws": "^8.21.3"
  }
}
